# Required for production. Run: npm run keygen
APP_MASTER_KEY=

PORT=3000
HOST=0.0.0.0

# Set to 1 only when Stream24 is actually served through HTTPS.
STREAM24_HTTPS=0

# Optional YouTube OAuth integration
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Optional native HTTPS (PEM files). When both are set, Stream24 serves HTTPS.
STREAM24_TLS_CERT_PATH=
STREAM24_TLS_KEY_PATH=

# First owner setup is localhost-only by default. Avoid enabling this unless required.
STREAM24_ALLOW_REMOTE_SETUP=0
