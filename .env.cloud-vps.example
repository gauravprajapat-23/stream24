# Copy to .env and replace every placeholder before deployment.
# Keep remote setup disabled. Use an SSH tunnel for first-run owner setup.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Fill this after creating a Worker in the dashboard. The token is shown only once.
STREAM24_AGENT_TOKEN=REPLACE_WITH_WORKER_TOKEN
# Maximum browser upload size in bytes (default 5 GiB).
STREAM24_MAX_UPLOAD_BYTES=5368709120

# SaaS billing is opt-in for backward-compatible self-hosted installs.
# Set true only after configuring Razorpay credentials/webhook and testing quotas.
STREAM24_SAAS_BILLING_ENFORCED=false
# Configure in the server environment/secret manager; never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Create these monthly plans in the Razorpay dashboard, then set their plan IDs.
# Prices are not preselected; set the matching amount in paise to the dashboard plan amount.
RAZORPAY_PLAN_MONTHLY_SINGLE=
STREAM24_MONTHLY_SINGLE_AMOUNT_PAISE=
RAZORPAY_PLAN_MONTHLY_FIVE=
STREAM24_MONTHLY_FIVE_AMOUNT_PAISE=
