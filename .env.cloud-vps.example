# Copy to .env and replace every placeholder before deployment.
# Keep remote setup disabled. Use an SSH tunnel for first-run owner setup.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Fill this after creating a Worker in the dashboard. The token is shown only once.
STREAM24_AGENT_TOKEN=REPLACE_WITH_WORKER_TOKEN
# Maximum browser upload size in bytes (default 5 GiB).
STREAM24_MAX_UPLOAD_BYTES=5368709120
